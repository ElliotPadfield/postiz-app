FROM node:22.23.4-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends g++ make python3 nginx \
    && rm -rf /var/lib/apt/lists/* \
    && npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2
RUN addgroup --system www && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
    && mkdir -p /www /uploads && chown -R www:www /www /var/lib/nginx
WORKDIR /app
COPY . /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf
ARG NEXT_PUBLIC_BACKEND_URL
ARG NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL
ENV NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=$NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY
RUN pnpm install --frozen-lockfile
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build
EXPOSE 5000
CMD ["sh", "-c", "nginx && pnpm run pm2"]
